# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Frontend (Node / React / Vite)
node_modules/
dist/
dist-ssr/
*.local
.npm
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
