# ==============================================================================
# Weather Anomaly Detection Platform — .gitignore
# ==============================================================================

# Operating System
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Python & Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Databases
*.db
*.sqlite
*.sqlite3

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Frontend (Node / React / Vite)
node_modules/
dist/
dist-ssr/
*.local
.npm
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project

# Logs
logs/
*.log

# Large Data Artifacts — keep locally, never commit to git
# Raw station data dumps
data/raw/*.csv
data/raw/*.parquet
data/raw/*.json

# Processed / cleaned datasets (large CSVs)
data/processed/*.csv
data/processed/*.parquet
# Exclude computed baseline JSONs (regenerated by ml/train.py)
data/processed/baseline_statistics.json
data/processed/baseline_stats.json
# Keep the small test fixture in git
!data/processed/sample_weather.csv

# Trained ML model artifacts (regenerate via ml/train.py)
ml/models/*.joblib
ml/models/*.pkl
ml/models/*.onnx
ml/models/*.h5

# Duplicate Root Data Dumps
output.csv

# Keep empty git directories with .gitkeep
!.gitkeep
