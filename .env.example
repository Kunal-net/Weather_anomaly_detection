# ==============================================================================
# AeroSense-AI — Environment Variable Template
# ==============================================================================
# Copy this file to .env and fill in your values.
# .env is in .gitignore and will NEVER be committed.
#
# Usage:
#   cp .env.example .env
# ==============================================================================

# --- Application ---
PROJECT_NAME="AeroSense-AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# --- CORS Origins ---
# Comma-separated list of allowed frontend origins.
# Development default: localhost Vite dev server.
# Production: replace with your deployed frontend domain.
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# --- Database ---
# SQLite (default, no setup required):
DATABASE_URL="sqlite:///./weather_anomaly.db"
# PostgreSQL example (production):
# DATABASE_URL="postgresql://user:password@localhost:5432/aerosense_db"

# --- ML Model & Data Artifact Paths ---
# Paths relative to project root. Run ml/train.py to regenerate these.
MODEL_PATH="ml/models/isolation_forest.joblib"
SCALER_PATH="ml/models/scaler.joblib"
BASELINE_STATS_PATH="data/processed/baseline_statistics.json"
